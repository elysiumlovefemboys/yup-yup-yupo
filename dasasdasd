connect(RunService.Heartbeat, function()
    local char = _c_lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not (state.pixel_surf and bindDown("pixel_surf") and hrp and hum and hum.Health > 0) then
        getgenv().autoSurfStartTick = nil; return
    end
    local inAir = (hum:GetState() == Enum.HumanoidStateType.Freefall
        or hum:GetState() == Enum.HumanoidStateType.Jumping
        or hum.FloorMaterial == Enum.Material.Air)
        and hum:GetState() ~= Enum.HumanoidStateType.Climbing
    local vel = hrp.AssemblyLinearVelocity
    if not (inAir and vel.Y < -5) then
        getgenv().autoSurfStartTick = nil; return
    end
    -- wall detection: probe in movement direction
    local uis = UserInputService
    if uis:IsKeyDown(Enum.KeyCode.S) or uis:IsKeyDown(Enum.KeyCode.A)
        or uis:IsKeyDown(Enum.KeyCode.D) or uis:IsKeyDown(Enum.KeyCode.LeftControl)
        or uis:IsKeyDown(Enum.KeyCode.C) then return end
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    if horizVel.Magnitude < 1 then getgenv().autoSurfStartTick = nil; return end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {char, workspace:FindFirstChild("Ray_Ignore")}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local wallHit = workspace:Raycast(hrp.Position, horizVel.Unit * 3.5, rp)
    if wallHit and math.abs(wallHit.Normal.Y) < 0.4 then
        local wn = wallHit.Normal
        local glideDir = horizVel.Unit - wn * horizVel.Unit:Dot(wn)
        if glideDir.Magnitude > 0.01 then
            if not getgenv().autoSurfStartTick then getgenv().autoSurfStartTick = tick() end
            if tick() - getgenv().autoSurfStartTick <= 0.15 then
                local speed = math.max(horizVel.Magnitude, state.surf_speed or 28)
                hrp.AssemblyLinearVelocity = Vector3.new(
                    glideDir.Unit.X * speed, vel.Y * 0.92, glideDir.Unit.Z * speed)
            else
                getgenv().autoSurfStartTick = nil
            end
        end
    else
        getgenv().autoSurfStartTick = nil
    end
end)

