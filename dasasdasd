local function inputForBind(bind)
    if not bind or bind == "none" or bind == "always on" then return false end
    local mouse = string.match(bind, "^M(%d+)$")
    if mouse then
        local ok, inputType = pcall(function()
            return Enum.UserInputType["MouseButton" .. mouse]
        end)
        return ok and inputType ~= nil and UserInputService:IsMouseButtonPressed(inputType)
    end
    local code = BIND_CODES[bind] or Enum.KeyCode[bind]
    return code ~= nil and UserInputService:IsKeyDown(code)
end

local function bindDown(name)
    if binds[name] == "always on" then return true end
    local mode = bindMode(name)
    if mode == "always on" then return true end
    if mode == "toggle" then return bind_toggles[name] == true end
    return inputForBind(binds[name])
end

local function normaliseKeyName(name)
    name = string.upper(name)
    if name == "LEFTALT" or name == "RIGHTALT" then return "ALT" end
    if name == "LEFTCONTROL" or name == "RIGHTCONTROL" then return "CTRL" end
    if name == "LEFTSHIFT" or name == "RIGHTSHIFT" then return "SHIFT" end
    if name == "INSERT" then return "INS" end
    return name
end

