                    spawnTracer(hit.Origin, hit.Position, state.tracer_local_color, state.tracer_local_alpha)
                end
            end
        end
    end

    if state.tracer_impacts and type(payload[1]) == "table" then
        for _, hit in ipairs(payload[1]) do
            if type(hit) == "table" and hit.Position then
                spawnImpact(hit.Position, hit.Normal)
            end
        end
    end
end

