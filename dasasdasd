    function sectionInterface:MultiDropdown(label, options)
        local prefix = (label and label:sub(1, 2) ~= "##") and (label .. ": ") or ""

        local function getSelectedSummary()
            local active = {}
            for _, opt in ipairs(options) do
                if state[opt.key] == true then
                    table.insert(active, opt.tag or opt.name)
                end
            end
            if #active == 0 then return "none" end
            if #active == #options then return "all (" .. #options .. ")" end
            return table.concat(active, ", ")
        end

        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 17),
            BackgroundTransparency = 1
        })

        local dropFrame = create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(16, 14, 18),
            BorderSizePixel = 0
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 2) }),
            create("UIStroke", { Color = Colors.DropdownBord, Thickness = 1 }),
            create("UIGradient", {
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, Color3.fromRGB(20, 20, 20)),
                    ColorSequenceKeypoint.new(1.0, Color3.fromRGB(9, 9, 9))
                })
            })
        })
        dropFrame.Parent = row

        local dropText = create("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 7, 0, 0),
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = prefix .. getSelectedSummary(),
            TextColor3 = Colors.Text,
            Font = Enum.Font.SourceSans,
            TextSize = 13,
            ClipsDescendants = true
        })
        dropText.Parent = dropFrame

        local arrow = create("TextLabel", {
            Size = UDim2.new(0, 14, 1, 0),
            Position = UDim2.new(1, -14, 0, 0),
            BackgroundTransparency = 1,
            Text = "▼",
            TextColor3 = Colors.TextBind,
            Font = Enum.Font.SourceSans,
            TextSize = 9
        })
        arrow.Parent = dropFrame

        local dropBtn = create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false
        })
        dropBtn.Parent = row

        local function refreshOptions()
            for _, child in ipairs(dropdownScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            for _, opt in ipairs(options) do
                local isChecked = state[opt.key] == true
                local optBtn = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = (isChecked and "✔  " or "    ") .. opt.name,
                    TextColor3 = isChecked and Colors.Accent() or Colors.Text,
                    Font = Enum.Font.SourceSans,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false
                }, {
                    create("UIPadding", { PaddingLeft = UDim.new(0, 7) })
                })

                optBtn.MouseEnter:Connect(function()
                    optBtn.TextColor3 = Colors.TextBright
                    optBtn.BackgroundTransparency = 0.9
                    optBtn.BackgroundColor3 = Colors.Accent()
                end)
                optBtn.MouseLeave:Connect(function()
                    optBtn.TextColor3 = (state[opt.key] == true) and Colors.Accent() or Colors.Text
                    optBtn.BackgroundTransparency = 1
                end)

                optBtn.MouseButton1Click:Connect(function()
                    state[opt.key] = not (state[opt.key] == true)
                    dropText.Text = prefix .. getSelectedSummary()
                    refreshOptions()
                    update_all_ui()
                end)

                optBtn.Parent = dropdownScroll
            end
        end

        dropBtn.MouseButton1Click:Connect(function()
            active_dropdown = label
            refreshOptions()
            local itemH = 16
            local totalH = math.min(#options * itemH + 6, 180)
            dropdownOverlay.Size = UDim2.new(0, dropFrame.AbsoluteSize.X, 0, totalH)
            local abPos = dropFrame.AbsolutePosition
            dropdownOverlay.Position = UDim2.new(0, abPos.X, 0, abPos.Y + 17)
            dropdownOverlay.Visible = true
        end)

        table.insert(UI_Updates, function()
            dropText.Text = prefix .. getSelectedSummary()
            arrow.TextColor3 = (active_dropdown == label) and Colors.Accent() or Colors.TextBind
        end)

        row.Parent = outline
    end

