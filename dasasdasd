local function angleTo(position)
    local cam = camera()
    if not cam then return math.huge end
    local offset = position - cam.CFrame.Position
    if offset.Magnitude < 1e-3 then return math.huge end
    local dot = math.clamp(cam.CFrame.LookVector:Dot(offset.Unit), -1, 1)
    return math.deg(math.acos(dot))
end

local aimPointOnPart

local function findTarget(strict, fovOverride)
    if not weaponAllowed() then return nil end

    local cam = camera()
    if not cam then return nil end

    local allowed = allowedParts()
    local fov = fovOverride or state.fov
    local limit = strict and math.min(fov, 1.5) or fov * 0.5
    local best, bestScore, bestPlayer, bestPosition

    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local char, humanoid = characterOf(plr)
            if char then
                for _, partName in ipairs(allowed) do
                    local part = findPart(char, partName)
                    if part then
                        local position = part.Position
                        if state.backtrack then
                            position = backtrackPosition(plr, position)
                        end
                        local angle = angleTo(position)
                        if angle <= limit then
                            local score = angle
                            if partName == "Head" then score = score * 0.7 end
                            if score < (bestScore or math.huge) then
                                if state.penetration or visible(cam.CFrame.Position, position) then
                                    best, bestScore, bestPlayer, bestPosition = part, score, plr, position
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if best and bestPlayer then
        if not state.backtrack and aimPointOnPart then
            local aim = aimPointOnPart(best, bestPlayer.Character, cam.CFrame.Position, cam.CFrame.LookVector)
            if aim then return best, bestPlayer, aim end
        end
        return best, bestPlayer, bestPosition
    end

    return best, bestPlayer, bestPosition
end

