local k_skin_categories = { "all", "rifles", "pistols", "smg", "heavy", "knives", "gloves", "extras" }
local k_skin_category_names = {
    rifles = "Rifles", pistols = "Pistols", smg = "SMG", heavy = "Heavy",
    knives = "Knives", gloves = "Gloves", extras = "Extras",
}

local skinCatalogCache = nil
local applySkinChanger = nil
local applyGloveChange = nil

local function skinCatalog()
    if skinCatalogCache then return skinCatalogCache end
    local storage = game:GetService("ReplicatedStorage"):FindFirstChild("Storage")
    local skins = storage and storage:FindFirstChild("Skins")
    local holder = skins and skins:FindFirstChild("SkinHolder")
    if not holder then return nil end

    local weapons, order = {}, {}
    for _, category in ipairs(holder:GetChildren()) do
        if category.Name ~= "Gloves" then
            for _, weaponFolder in ipairs(category:GetChildren()) do
                local skinsList = {
                    { name = "Stock", patterns = { "1" }, stock = true },
                }
                for _, skinFolder in ipairs(weaponFolder:GetChildren()) do
                    local patterns = {}
                    for _, patternFolder in ipairs(skinFolder:GetChildren()) do
                        patterns[#patterns + 1] = patternFolder.Name
                    end
                    table.sort(patterns, function(a, b)
                        local na, nb = tonumber(a), tonumber(b)
                        if na and nb then return na < nb end
                        return a < b
                    end)
                    skinsList[#skinsList + 1] = { name = skinFolder.Name, patterns = patterns }
                end
                table.sort(skinsList, function(a, b) return a.name < b.name end)
                if #skinsList > 1 then
                    weapons[weaponFolder.Name] = { category = category.Name, skins = skinsList }
                    order[#order + 1] = weaponFolder.Name
                end
            end
        end
    end

    local components = storage and storage:FindFirstChild("ViewmodelComponents")
    local gloveModels = components and components:FindFirstChild("Gloves")
    if gloveModels then
        for _, weaponFolder in ipairs(gloveModels:GetChildren()) do
            if weaponFolder.Name ~= "Stock" then
                local skinsList = {
                    { name = "Stock", patterns = { "1" }, stock = true },
                }
                for _, skinFolder in ipairs(weaponFolder:GetChildren()) do
                    if skinFolder.Name ~= "Stock" then
                        skinsList[#skinsList + 1] = { name = skinFolder.Name, patterns = { "1" } }
                    end
                end
                table.sort(skinsList, function(a, b) return a.name < b.name end)
                weapons[weaponFolder.Name] = { category = "Gloves", skins = skinsList }
                order[#order + 1] = weaponFolder.Name
            end
        end
    end

    table.sort(order)
    skinCatalogCache = { weapons = weapons, order = order }
    return skinCatalogCache
end

local function skinWeaponNames()
    local catalog = skinCatalog()
    local list = {}
    if not catalog then return list end
    local wanted = k_skin_category_names[k_skin_categories[state.skin_category_sel] or "all"] or nil
    local search = string.lower(state.skin_search or "")
    for _, name in ipairs(catalog.order) do
        local info = catalog.weapons[name]
        if (not wanted or info.category == wanted)
            and (search == "" or string.find(string.lower(name), search, 1, true)) then
            list[#list + 1] = name
        end
    end
    return list
end

local function currentSkinWeapon()
    local list = skinWeaponNames()
    local name = state.skin_weapon_name
    for _, candidate in ipairs(list) do
        if candidate == name then return candidate end
    end
    return list[state.skin_weapon_sel] or list[1]
end

local function skinOptionsForWeapon()
    local catalog = skinCatalog()
    local weapon = currentSkinWeapon()
    local info = catalog and weapon and catalog.weapons[weapon]
    if not info then return {} end
    local search = string.lower(state.skin_search or "")
    if search == "" then return info.skins end
    local filtered = {}
    for _, skin in ipairs(info.skins) do
        if string.find(string.lower(skin.name), search, 1, true) then
            filtered[#filtered + 1] = skin
        end
    end
    if #filtered == 0 then return info.skins end
    return filtered
end

local function currentSkinInfo()
    local weapon = currentSkinWeapon()
    local options = skinOptionsForWeapon()
    if not weapon or #options == 0 then return nil end

    local skin
    for _, candidate in ipairs(options) do
        if candidate.name == state.skin_skin_name then skin = candidate break end
    end
    skin = skin or options[state.skin_skin_sel] or options[1]
    if not skin then return nil end

    local pattern = state.skin_pattern_name
    local valid = false
    for _, candidate in ipairs(skin.patterns) do
        if candidate == pattern then valid = true break end
    end
    if not valid then pattern = skin.patterns[state.skin_pattern_sel] or skin.patterns[1] or "1" end

    return weapon, skin.name, pattern, skin
end


local function unlockAllSkins()
    local okApi, api = pcall(function()
        return require(game:GetService("ReplicatedFirst").ClientInitializer.ClientProcesses.GetInitialPlayerData)
    end)
    if not okApi or type(api) ~= "table" then return 0, 0, "player data unavailable" end

    local okHolder, holder = pcall(function()
        return require(game:GetService("ReplicatedStorage").Storage.Skins.SkinHolder)
    end)
    if not okHolder or type(holder) ~= "table" then return 0, 0, "skin database unavailable" end

    local http = game:GetService("HttpService")
    local unlocked, owned, total = 0, 0, 0

    local function processItem(item)
        if type(item) ~= "table" then return end
        if item.SkinName then
            total = total + 1
            if item.UUID ~= nil and item.UUID ~= "" then
                owned = owned + 1
            else
                item.UUID = "{" .. http:GenerateGUID(false) .. "}"
                item.Tradeable = false
                unlocked = unlocked + 1
            end
        end
    end

    local function walkTable(t, depth)
        if depth > 6 then return end
        for _, v in pairs(t) do
            if type(v) == "table" then
                processItem(v)
                walkTable(v, depth + 1)
            end
        end
    end

    local inv = api.GetAllInventory
    if type(inv) == "table" then
        walkTable(inv, 0)
    else
        walkTable(api, 0)
    end

    for weaponName, skinList in pairs(holder) do
        if type(skinList) == "table" then
            for skinId, skinData in pairs(skinList) do
                if type(skinData) == "table" then
                    local found = false
                    local inv2 = api.GetAllInventory
                    if type(inv2) == "table" then
                        local wepInv = inv2[weaponName]
                        if type(wepInv) == "table" then
                            for _, item in ipairs(wepInv) do
                                if type(item) == "table" and item.SkinName == skinId then
                                    found = true
                                    break
                                end
                            end
                            if not found then
                                table.insert(wepInv, {
                                    SkinName = skinId,
                                    UUID = "{" .. http:GenerateGUID(false) .. "}",
                                    Tradeable = false,
                                    StatTrak = false,
                                    StatTrakCount = 0,
                                    Wear = math.random(1, 4),
                                })
                                unlocked = unlocked + 1
                                total = total + 1
                            end
                        end
                    end
                end
            end
        end
    end

    return unlocked, total, nil, owned
end

