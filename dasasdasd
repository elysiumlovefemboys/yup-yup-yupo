        if isEnemy(plr) then
            result.enemies = result.enemies + 1
            local char = characterOf(plr)
            if char then
                result.characters = result.characters + 1
                for _, name in ipairs(allowedParts()) do
                    local part = findPart(char, name)
                    if part then
                        table.insert(result.parts, name)
                        local angle = angleTo(part.Position)
                        if angle <= state.fov * 0.5 then
                            result.inFov = result.inFov + 1
                            if state.penetration or visible(cam.CFrame.Position, part.Position) then
                                result.visible = result.visible + 1
                            end
                        end
                    end
                end
            end
        end
    end

    return result
end


