local function simulateArc(origin, velocity, steps, dt)
    local points = { origin }
    local position = origin
    local vel = velocity
    local params = getWorldFilter()
    for _ = 1, steps do
        local nextPosition = position + vel * dt
        vel = vel + Vector3.new(0, -workspace.Gravity * dt, 0)
        local result = workspace:Raycast(position, nextPosition - position, params)
        if result then
            points[#points + 1] = result.Position
            break
        end
        points[#points + 1] = nextPosition
        position = nextPosition
        if position.Y < origin.Y - 600 then break end
    end
    return points
end

local lighting = game:GetService("Lighting")
local lightSaved = {}

local function saveLighting(feature, properties, atmosphere)
    if lightSaved[feature] then return end
    local saved = {}
    for _, property in ipairs(properties) do
        saved[property] = lighting[property]
    end
    if atmosphere then
        saved.__atmosphere = atmosphere
        saved.__density = atmosphere.Density
    end
    lightSaved[feature] = saved
end

local function restoreLighting(feature)
    local saved = lightSaved[feature]
    if not saved then return end
    for property, value in pairs(saved) do
        if property ~= "__atmosphere" and property ~= "__density" then
            lighting[property] = value
        end
    end
    if saved.__atmosphere and saved.__density ~= nil then
        saved.__atmosphere.Density = saved.__density
    end
    lightSaved[feature] = nil
end

