local function rewritePayload(payload, statsArg)
    if type(payload) ~= "table" then return end

    local part, player, position = findTarget(false, state.silent_fov)
    if not part then return end
    if player == LocalPlayer then return end

    local char = part.Parent
    local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local cam = camera()
    if not cam then return end

    local origin = cam.CFrame.Position
    local offset = position - origin
    if offset.Magnitude < 1e-3 then return end

    local direction = offset.Unit
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = hitboxList(char)
    params.RespectCanCollide = false

    local trace = workspace:Raycast(origin, direction * 1000, params)
    local instance, surface, normal, distance, material
    if trace and trace.Instance:IsDescendantOf(char) then
        instance, surface, normal, distance, material =
            trace.Instance, trace.Position, trace.Normal, trace.Distance, trace.Material
    else
        instance, surface, normal, distance, material =
            part, position, -direction, offset.Magnitude, part.Material
    end

    local delta = surface - origin
    local travel = delta.Magnitude
    if travel < 1e-3 then return end
    local shotDirection = delta.Unit

    local pellets = type(payload[2]) == "table" and #payload[2] or 0
    if type(statsArg) == "table" and type(statsArg.ShotgunPelletCount) == "number" then
        pellets = math.max(pellets, statsArg.ShotgunPelletCount)
    end
    if pellets < 1 then pellets = 1 end

    local hits, rays = {}, {}
    for i = 1, pellets do
        hits[i] = {
            PelletIndex = i,
            Instance = instance,
            Position = surface,
            Normal = normal,
            Origin = origin,
            Distance = travel,
            Material = material,
            Penetration = 0,
            HitPlayerCharacter = { char, i },
            IsMelee = false,
        }
        rays[i] = { origin, shotDirection * 999 }
    end

    payload[1] = hits
    payload[2] = rays

    if type(payload[3]) == "table" then
        payload[3] = { { origin, surface } }
    end
end

local function zeroSpread(stats)
    local saved = {}
    local function patchArray(field, minimum, replacement)
        local values = stats[field]
        if type(values) ~= "table" then return end
        local length = math.max(#values, minimum)
        saved[field] = {}
        for i = 1, length do
            saved[field][i] = values[i]
            if type(replacement) == "table" then
                values[i] = { replacement[1], replacement[2] }
            else
                values[i] = replacement
            end
        end
    end
    patchArray("MovementAccuracy", 4, 100)
    patchArray("AccurateRange", 4, 1e6)
    patchArray("BulletRecoil", 0, { 0, 0 })
    patchArray("BurstBulletRecoil", 0, { 0, 0 })

    return function()
        for field, values in pairs(saved) do
            for index, value in pairs(values) do
                stats[field][index] = value
            end
        end
    end
end

if rayModule and type(rayModule.GetRaycast) == "function" then
    local original = rayModule.GetRaycast
    local callOriginal
    local stats = { calls = 0, rewritten = 0, installed = false }
    getgenv().bankroll_hook = stats

    local function hooked(statsArg, ...)
        stats.calls = stats.calls + 1
        local isGun = type(statsArg) == "table" and (statsArg.Type == "Primary" or statsArg.Type == "Secondary")

        local restore
        if isGun and (state.seed_pred or state.recoil_ctrl) then
            restore = zeroSpread(statsArg)
        end

        local packed = table.pack(pcall(callOriginal, statsArg, ...))
        if restore then restore() end
        if not packed[1] then error(packed[2], 0) end

        if state.silent and (isGun or state.override_shared) then
            for i = 2, packed.n do
                if type(packed[i]) == "table" then
                    local ok = pcall(rewritePayload, packed[i], statsArg)
                    if ok then stats.rewritten = stats.rewritten + 1 end
                end
            end
        end

        local visuals = getgenv().bankroll_visuals
        if visuals and type(visuals.shot) == "function" then
            for i = 2, packed.n do
                if type(packed[i]) == "table" then
                    pcall(visuals.shot, packed[i], true)
                end
            end
        end

        return table.unpack(packed, 2, packed.n)
    end

    if type(hookfunction) == "function" then
        local ok, replacement = pcall(hookfunction, original, hooked)
        if ok and type(replacement) == "function" then
            callOriginal = replacement
            stats.installed = true
        end
    end
    if not callOriginal then
        callOriginal = original
        pcall(function() rayModule.GetRaycast = hooked end)
        stats.installed = true
    end
end


