            chamsOccOutline = state.friendly_chams_occluded_outline_color
            chamsOccFillAlpha = state.friendly_chams_occluded_fill_alpha
            chamsOccOutlineAlpha = state.friendly_chams_occluded_outline_alpha
            chamsAnimName = k_chams_anim[state.friendly_chams_anim_sel] or "Disabled"
            maxDistance = state.friendly_max_distance or 400
        else
            boxOn = state.box
            fillOn = state.box_fill
            spinOn = state.box_fill_spin
            healthOn = state.health
            nameOn = state.name
            weaponOn = state.weapon
            skeletonOn = state.skeleton
            glowOn = state.glow
            distanceOn = state.distance or state.flags_esp
            chamsOn = state.chams
            boxColor = state.box_color
            fillColor1 = state.box_fill_color1
            fillColor2 = state.box_fill_color2
            fillAlpha1 = state.box_fill_alpha1
            fillAlpha2 = state.box_fill_alpha2
            healthType = state.health_type
            healthLow = state.health_color2
            healthHigh = state.health_color
            healthAlpha = state.health_alpha
            chamsFill = state.chams_fill_color
            chamsOutline = state.chams_outline_color
            chamsFillAlpha = state.chams_fill_alpha
            chamsOutlineAlpha = state.chams_outline_alpha
            chamsOccOn = state.chams_occluded
            chamsOccFill = state.chams_occluded_fill_color
            chamsOccOutline = state.chams_occluded_outline_color
            chamsOccFillAlpha = state.chams_occluded_fill_alpha
            chamsOccOutlineAlpha = state.chams_occluded_outline_alpha
            chamsAnimName = k_chams_anim[state.chams_anim_sel] or "Disabled"
            maxDistance = state.max_distance or 400
        end

        local cham = entry.cham
        if cham then
            if chamsOn and char then
                if cham.Parent ~= char then cham.Parent = char end
                cham.Enabled = true
                cham.FillColor = chamsFill
                cham.OutlineColor = chamsOutline
                cham.FillTransparency = 1 - chamsFillAlpha
                cham.OutlineTransparency = 1 - chamsOutlineAlpha
            else
                cham.Enabled = false
            end
        end

        local anyOn = boxOn or fillOn or healthOn or nameOn or weaponOn or skeletonOn or glowOn
            or distanceOn or (not friendly and (state.visible or state.occluded or state.out_of_view))

        local show = anyOn and char
            and ((friendly and state.visuals_subtab == 2)
                or (not friendly and isEnemy(plr) and state.visuals_subtab ~= 2))

        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if show and (not hum or not head or not hrp
            or (origin - hrp.Position).Magnitude > maxDistance) then
            show = false
        end

        if not show then
            entry.root.Visible = false
            entry.arrow.Visible = false
            if entry.cham then entry.cham.Enabled = false end
            if entry.chamOccluded then entry.chamOccluded.Enabled = false end
            if entry.stepCircle then
                entry.stepCircle.Visible = false
                entry.stepCircle.Adornee = nil
            end
            if char then
                for _, desc in ipairs(char:GetDescendants()) do
                    if desc:IsA("MeshPart") then
                        local tag = desc:FindFirstChild("bankroll_cham_tex")
                        if tag then desc.TextureID = tag.Value; tag:Destroy() end
                    end
                end
            end
            continue
        end

        local screen, onScreen = cam:WorldToViewportPoint(head.Position)
        if not onScreen then
            entry.root.Visible = false

            if state.out_of_view and not friendly and state.visuals_subtab ~= 2 then
                local rel = cam.CFrame:PointToObjectSpace(head.Position)
                local yaw = math.atan2(rel.X, -rel.Z)
                local radius = math.min(cam.ViewportSize.X, cam.ViewportSize.Y)
                    * 0.42 * ((state.oov_distance or 40) / 40)
                entry.arrow.Position = UDim2.fromOffset(
                    cam.ViewportSize.X * 0.5 + math.sin(yaw) * radius,
                    cam.ViewportSize.Y * 0.5 - math.cos(yaw) * radius * 0.6
                )
                entry.arrow.Rotation = math.deg(yaw)
                entry.arrow.TextSize = state.oov_size or 13
                entry.arrow.TextColor3 = state.oov_color
                local alpha = state.oov_alpha
                if state.oov_blink then
                    alpha = alpha * (0.35 + 0.65 * math.abs(math.sin(now * (state.oov_blink_speed or 1) * 3)))
                end
                entry.arrow.TextTransparency = 1 - alpha
                entry.arrow.Visible = true
            else
                entry.arrow.Visible = false
            end
            continue
        end
        entry.arrow.Visible = false

        local top, bottom, left, right
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1
                and not part:FindFirstAncestorOfClass("Accessory")
                and not part:FindFirstAncestorOfClass("Tool") then
                local cf, size = part.CFrame, part.Size
                local pTop, pBottom, pLeft, pRight = math.huge, -math.huge, math.huge, -math.huge
                local valid = true
                for _, corner in ipairs(BOX_CORNERS) do
                    local world = cf * Vector3.new(size.X * corner.X, size.Y * corner.Y, size.Z * corner.Z)
                    local sp, on = cam:WorldToViewportPoint(world)
                    if not on then
                        valid = false
                        break
                    end
                    pTop = math.min(pTop, sp.Y)
                    pBottom = math.max(pBottom, sp.Y)
                    pLeft = math.min(pLeft, sp.X)
                    pRight = math.max(pRight, sp.X)
                end
                if valid then
                    top = top and math.min(top, pTop) or pTop
                    bottom = bottom and math.max(bottom, pBottom) or pBottom
                    left = left and math.min(left, pLeft) or pLeft
                    right = right and math.max(right, pRight) or pRight
                end
            end
        end

        if not top then
            top, bottom = screen.Y - 18, screen.Y + 18
            left, right = screen.X - 12, screen.X + 12
        end

        local width = math.max(right - left, 2)
        local height = math.max(bottom - top, 2)
        local padding = state.box_padding or 0

        entry.root.Visible = true
        entry.root.Position = UDim2.fromOffset(left - padding, top - padding)
        entry.root.Size = UDim2.fromOffset(width + padding * 2, height + padding * 2)

        local chamOcc = entry.chamOccluded
        if chamOcc then
            if chamsOccOn then
                if chamOcc.Parent ~= char then chamOcc.Parent = char end
                chamOcc.Enabled = true
                chamOcc.FillColor = chamsOccFill
                chamOcc.OutlineColor = chamsOccOutline
                chamOcc.FillTransparency = 1 - chamsOccFillAlpha
                chamOcc.OutlineTransparency = 1 - chamsOccOutlineAlpha
            else
                chamOcc.Enabled = false
            end
        end

        do
            local animId = (chamsAnimName and chamsAnimName ~= "Disabled")
                and (ChamsAnimations[chamsAnimName] or "") or ""
            for _, desc in ipairs(char:GetDescendants()) do
                if desc:IsA("MeshPart") and not desc:FindFirstAncestorOfClass("Accessory") then
                    local tag = desc:FindFirstChild("bankroll_cham_tex")
                    if chamsOn and animId ~= "" then
                        if not tag then
                            tag = Instance.new("StringValue")
                            tag.Name = "bankroll_cham_tex"
                            tag.Value = desc.TextureID
                            tag.Parent = desc
                        end
                        desc.TextureID = animId
                    elseif tag then
                        desc.TextureID = tag.Value
                        tag:Destroy()
                    end
                end
            end
        end

        do
            local stepCircle = entry.stepCircle
            local hrpNow = char:FindFirstChild("HumanoidRootPart")
            if state.sound_circle and hrpNow and stepCircle then
                local velY = hrpNow.AssemblyLinearVelocity.Y
                local wasAir = entry._wasAirborne
                local isAir = velY < -4
                if wasAir and not isAir and not entry.stepActive then
                    entry.stepActive = true
                    entry.stepT = 0
                    stepCircle.Adornee = hrpNow
                    stepCircle.Visible = true
                end
                entry._wasAirborne = isAir

                local flat = hrpNow.AssemblyLinearVelocity
                flat = Vector3.new(flat.X, 0, flat.Z)
                if flat.Magnitude > 4 then
                    entry._stepClock = (entry._stepClock or 0) + (1 / math.max(state.esp_refresh or 60, 1))
                    if entry._stepClock >= 0.35 then
                        entry._stepClock = 0
                        if not entry.stepActive then
                            entry.stepActive = true
                            entry.stepT = 0
                            stepCircle.Adornee = hrpNow
                            stepCircle.Visible = true
                        end
                    end
                else
                    entry._stepClock = 0
                end

                if entry.stepActive then
                    local dur = math.max(state.sound_circle_duration or 0.6, 0.1)
                    entry.stepT = entry.stepT + (1 / math.max(state.esp_refresh or 60, 1))
                    local t = math.min(entry.stepT / dur, 1)
                    stepCircle.Radius = t * (state.sound_circle_radius or 6)
                    stepCircle.Color3 = state.sound_circle_color
                    stepCircle.Transparency = t
                    if t >= 1 then
                        entry.stepActive = false
                        stepCircle.Visible = false
                        stepCircle.Radius = 0
                    end
                end
            else
                if stepCircle then
                    stepCircle.Visible = false
                    stepCircle.Adornee = nil
                end
                entry._wasAirborne = false
                entry._stepClock = 0
            end
        end

        local boxAlpha = friendly and state.friendly_box_alpha or state.box_alpha
        local glowColor1 = friendly and state.friendly_glow_color1 or state.glow_color1
        local glowColor2 = friendly and state.friendly_glow_color2 or state.glow_color2
        local glowAlpha = friendly and state.friendly_glow_alpha1 or state.glow_alpha1
        local thickness = math.max(state.box_thickness or 1, 1)
        local rounding = UDim.new(0, state.box_round or 0)
        local style = state.box_style or 1

        entry.box.Visible = boxOn or fillOn
        entry.box.Size = UDim2.fromScale(1, 1)
        entry.boxCorner.CornerRadius = rounding
        entry.fillCorner.CornerRadius = rounding
        entry.innerCorner.CornerRadius = rounding

        entry.stroke.Enabled = boxOn and style ~= 2
        entry.stroke.Thickness = thickness
        entry.stroke.Color = boxColor
        entry.stroke.Transparency = 1 - boxAlpha
        entry.strokeGradient.Enabled = boxOn and state.box_gradient
        if state.box_gradient then
            entry.strokeGradient.Color = ColorSequence.new(state.box_gradient_color1, state.box_gradient_color2)
            entry.strokeGradient.Rotation = state.box_gradient_spin and ((now * 90) % 360) or (state.box_gradient_rot or 0)
        end

        entry.innerBox.Visible = boxOn and style == 3
        if style == 3 then
            local gap = math.max(state.box_gap or 2, 1)
            entry.innerBox.Position = UDim2.fromOffset(gap, gap)
            entry.innerBox.Size = UDim2.new(1, -gap * 2, 1, -gap * 2)
            entry.innerStroke.Color = boxColor
            entry.innerStroke.Thickness = math.max(thickness - 0.4, 0.5)
            entry.innerStroke.Transparency = 1 - boxAlpha * 0.62
        end

        local showCorners = boxOn and style == 2
        local rootSize = entry.root.AbsoluteSize
        local bracketLen = math.clamp(math.min(rootSize.X, rootSize.Y) * 0.22, 6, 24)
        for index, bracket in ipairs(entry.corners) do
            bracket.Visible = showCorners
            if showCorners then
                local cornerIndex = math.ceil(index / 2)
                local horizontal = index % 2 == 1
                bracket.BackgroundColor3 = boxColor
                bracket.BackgroundTransparency = 1 - boxAlpha
                bracket.Size = horizontal and UDim2.fromOffset(bracketLen, thickness) or UDim2.fromOffset(thickness, bracketLen)
                local x, y
                if cornerIndex == 1 then
                    x, y = 0, 0
                elseif cornerIndex == 2 then
                    x, y = rootSize.X - (horizontal and bracketLen or thickness), 0
                elseif cornerIndex == 3 then
                    x, y = 0, rootSize.Y - (horizontal and thickness or bracketLen)
                else
                    x = rootSize.X - (horizontal and bracketLen or thickness)
                    y = rootSize.Y - (horizontal and thickness or bracketLen)
                end
                bracket.Position = UDim2.fromOffset(x, y)
            end
        end

        entry.shadow.Visible = state.box_shadow and (boxOn or fillOn)
        if entry.shadow.Visible then
            local offset = state.box_shadow_offset or 2
            entry.shadow.Position = UDim2.fromOffset(offset, offset)
            entry.shadow.Size = UDim2.fromScale(1, 1)
            entry.shadowStroke.Color = state.box_shadow_color
            entry.shadowStroke.Thickness = thickness + 2
            entry.shadowStroke.Transparency = 1 - math.clamp(state.box_shadow_alpha, 0, 1)
        end

        entry.fill.Visible = fillOn
        if fillOn then
            entry.fill.BackgroundColor3 = fillColor1
            entry.fill.BackgroundTransparency = 0
            entry.fillGradient.Color = ColorSequence.new(fillColor1, fillColor2)
            entry.fillGradient.Transparency = NumberSequence.new(1 - fillAlpha1, 1 - fillAlpha2)
            entry.fillGradient.Rotation = spinOn and ((now * 120) % 360) or 0
        end

        local softness = math.clamp(math.floor(state.glow_softness or 2), 1, 3)
        local pulse = 1
        if state.glow_pulse then
            pulse = 0.5 + 0.5 * math.abs(math.sin(now * (state.glow_pulse_speed or 1) * 3.5))
        end
        for index, glowStroke in ipairs(entry.glows) do
            local active = glowOn and index <= softness
            glowStroke.Enabled = active
            if active then
                glowStroke.Color = index == 1 and glowColor1 or glowColor2
                glowStroke.Thickness = math.max((state.glow_thickness or 4) * (0.3 + index * 0.5), 1)
                local alpha = glowAlpha * (1 - (index - 1) / (softness + 2)) * pulse
                glowStroke.Transparency = 1 - math.clamp(alpha, 0, 1)
            end
        end

        entry.healthBack.Visible = healthOn
        if healthOn then
            local side = state.health_side or 1
            local healthWidth = math.max(state.health_width or 3, 1)
            local healthFraction = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            if side == 1 or side == 2 then
                entry.healthBack.Size = UDim2.new(0, healthWidth, 1, 0)
                entry.healthBack.Position = side == 1 and UDim2.new(0, -healthWidth - 4, 0, 0) or UDim2.new(1, 4, 0, 0)
                entry.healthFill.AnchorPoint = Vector2.new(0, 1)
                entry.healthFill.Position = UDim2.new(0, 0, 1, 0)
                entry.healthFill.Size = UDim2.fromScale(1, healthFraction)
            else
                entry.healthBack.Size = UDim2.new(1, 0, 0, healthWidth)
                entry.healthBack.Position = side == 3 and UDim2.new(0, 0, 0, -healthWidth - 4) or UDim2.new(0, 0, 1, 4)
                entry.healthFill.AnchorPoint = Vector2.new(0, 0)
                entry.healthFill.Position = UDim2.new(0, 0, 0, 0)
                entry.healthFill.Size = UDim2.fromScale(healthFraction, 1)
            end
            if healthType == 2 then
                entry.healthGradient.Enabled = false
                entry.healthFill.BackgroundColor3 = healthLow:Lerp(healthHigh, healthFraction)
                entry.healthFill.BackgroundTransparency = 1 - healthAlpha
            elseif healthType == 3 then
                entry.healthFill.BackgroundColor3 = Color3.new(1, 1, 1)
                entry.healthFill.BackgroundTransparency = 0
                entry.healthGradient.Enabled = true
                entry.healthGradient.Rotation = (side == 1 or side == 2) and 90 or 0
                entry.healthGradient.Color = ColorSequence.new(healthHigh, healthLow)
                entry.healthGradient.Transparency = NumberSequence.new(0, 0)
            else
                entry.healthGradient.Enabled = false
                entry.healthFill.BackgroundColor3 = healthHigh
                entry.healthFill.BackgroundTransparency = 1 - healthAlpha
            end
        end

        entry.name.Visible = nameOn
        if nameOn then
            entry.name.Text = plr.Name
            entry.name.TextColor3 = friendly and state.friendly_name_color or state.name_color
            entry.name.TextTransparency = 1 - (friendly and state.friendly_name_alpha or state.name_alpha)
        else
            entry.name.Text = ""
        end

        entry.weapon.Visible = weaponOn
        if weaponOn then
            local weaponName, weaponSkin, ammo, magSize = playerWeapon(plr)
            local text = weaponName and tostring(weaponName) or ""
            if text ~= "" and state.weapon_skin and weaponSkin and weaponSkin ~= "" and weaponSkin ~= "Stock" then
                text = text .. " · " .. tostring(weaponSkin)
            end
            if text ~= "" and state.weapon_ammo and ammo then
                text = string.format("%s [%s/%s]", text, tostring(math.floor(ammo)), tostring(math.floor(magSize or 0)))
            end
            entry.weapon.Text = text
            entry.weapon.TextColor3 = friendly and state.friendly_weapon_color or state.weapon_color
            entry.weapon.TextTransparency = 1 - (friendly and state.friendly_weapon_alpha or state.weapon_alpha)
        else
            entry.weapon.Text = ""
        end

        entry.flags.Visible = distanceOn

        local needsVisibility = (not friendly) and (state.flags_esp or state.visible or state.occluded)
        local seen = true
        if needsVisibility then
            seen = visible(origin, head.Position)
        end

        if distanceOn then
            local distance = math.floor((origin - hrp.Position).Magnitude)
            if friendly then
                entry.flags.Text = distance .. "m"
                entry.flags.TextColor3 = state.friendly_distance_color
                entry.flags.TextTransparency = 1 - state.friendly_distance_alpha
            else
                local parts = {}
                if state.flags_esp then
                    parts[1] = seen and "visible" or "occluded"
                    if state.visible and not seen then parts[1] = "" end
                    if state.occluded and seen and not state.visible then parts[1] = "" end
                end
                parts[#parts + 1] = distance .. "m"

                if state.exploiting then
                    local speed = hrp.AssemblyLinearVelocity.Magnitude
                    if speed > 45 or hum.WalkSpeed > 30 then
                        parts[#parts + 1] = "exploiting"
                        entry.flags.TextColor3 = state.exploiting_color
                        entry.flags.TextTransparency = 1 - state.exploiting_alpha
                    end
                end

                entry.flags.Text = table.concat(parts, " · ")
                if not (state.exploiting and table.concat(parts, " · "):find("exploiting")) then
                    entry.flags.TextColor3 = state.distance and state.distance_color or state.flags_color1
                    entry.flags.TextTransparency = 1 - (state.distance and state.distance_alpha or state.flags_alpha1)
                end
            end
        else
            entry.flags.Text = ""
        end

        if not friendly then
            if state.visible and not seen then entry.root.Visible = false end
            if state.occluded and seen and not state.visible then entry.root.Visible = false end
        end

        entry.bones[1].Parent = entry.root
        if skeletonOn then
            for index, pair in ipairs(SKELETON) do
                local a = findPart(char, pair[1])
                local b = findPart(char, pair[2])
                local line = entry.bones[index]
                if a and b then
                    local sa, va = cam:WorldToViewportPoint(a.Position)
                    local sb, vb = cam:WorldToViewportPoint(b.Position)
                    if va and vb then
                        local delta = Vector2.new(sb.X - sa.X, sb.Y - sa.Y)
                        local length = delta.Magnitude
                        line.Visible = length > 1
                        line.Size = UDim2.fromOffset(length, 1)
                        line.Position = UDim2.fromOffset(sa.X - left + delta.X / 2, sa.Y - top + delta.Y / 2)
                        line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                        line.BackgroundColor3 = friendly and state.friendly_skeleton_color or state.skeleton_color
                        line.BackgroundTransparency = 1 - (friendly and state.friendly_skeleton_alpha or state.skeleton_alpha)
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        else
            for _, line in ipairs(entry.bones) do line.Visible = false end
        end
    end
end

