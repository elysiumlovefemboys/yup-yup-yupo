connect(RunService.Stepped, function(_, dt)
    local hum, hrp = humanoid(), root()
    if not hum or not hrp then return end

    local now = os.clock()
    local cam = camera()
    local velocity = hrp.AssemblyLinearVelocity
    local flat = flatOf(velocity)
    local grounded = onFloor()
    local spaceDown = UserInputService:IsKeyDown(Enum.KeyCode.Space)
    local ladder = onLadder(hrp)
    local moveDirection = hum.MoveDirection

    movementStats.ticks = movementStats.ticks + 1
    movementStats.grounded = grounded
    movementStats.airborne = not grounded
    movementStats.onLadder = ladder ~= nil
    movementStats.surfing = false
    movementStats.airstuck = false
    movementStats.speed = flat.Magnitude

    if state.airstuck and bindDown("airstuck") and not grounded then
        if not airstuckPos then airstuckPos = hrp.Position end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(airstuckPos) * hrp.CFrame.Rotation
        movementStats.airstuck = true
        movementStats.speed = 0
        return
    end
    airstuckPos = nil

    if state.bhop and bindDown("bhop") and spaceDown and grounded then
        jump()
    end

    if state.jump_bug and bindDown("jump_bug") and spaceDown and grounded
        and now - lastJumpBug > 0.25 and flat.Magnitude > 6 then
        local boost = flat * 1.35
        if boost.Magnitude > 34 then boost = boost.Unit * 34 end
        jump()
        hrp.AssemblyLinearVelocity = Vector3.new(boost.X, state.jump_bug_height or 40, boost.Z)
        lastJumpBug = now
        velocity = hrp.AssemblyLinearVelocity
        flat = flatOf(velocity)
        grounded = false
    end

    if state.auto_strafe and bindDown("auto_strafe") and not grounded and not ladder then
        local wish = flatOf(moveDirection)
        if wish.Magnitude > 0.1 then
            hum.WalkSpeed = 0
            wish = wish.Unit
            local cap = math.max(state.strafe_speed or 26, flat.Magnitude)
            local add = cap - flat:Dot(wish)
            if add > 0 then
                local gain = math.min(add, 60 * dt)
                local turned = flat + wish * gain
                if turned.Magnitude > cap then turned = turned.Unit * cap end
                velocity = Vector3.new(turned.X, velocity.Y, turned.Z)
                hrp.AssemblyLinearVelocity = velocity
                flat = flatOf(velocity)
            end
        end
    end

    if state.edge_jump and bindDown("edge_jump") and not grounded
        and now - lastEdgeJump > 0.15 and velocity.Y < -8 and flat.Magnitude > 6 then
        local below = workspace:Raycast(hrp.Position, Vector3.new(0, -3, 0), getWorldFilter())
        if below and below.Normal.Y > 0.7 then
            hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            velocity = hrp.AssemblyLinearVelocity
            flat = flatOf(velocity)
            lastEdgeJump = now
        end
    end

    if state.pixel_surf and bindDown("pixel_surf") and not ladder then
        if grounded then
            surfHeight = nil
            surfNormal = nil
        else
            local wish = flatOf(moveDirection)
            local direction
            if wish.Magnitude > 0.1 then
                direction = wish.Unit
            elseif flat.Magnitude > 0.1 then
                direction = flat.Unit
            end

            local hit
            if surfNormal then
                local probe = workspace:Raycast(hrp.Position, -surfNormal * 2.6, getWorldFilter())
                if probe and math.abs(probe.Normal.Y) < 0.45 then hit = probe end
            end
            if not hit and direction then
                local probe = workspace:Raycast(hrp.Position, direction * 2.6, getWorldFilter())
                if probe and math.abs(probe.Normal.Y) < 0.45 then hit = probe end
            end

            if hit then
                surfNormal = hit.Normal
                if not surfHeight then surfHeight = hrp.Position.Y end

                local tangent = direction and (direction - surfNormal * direction:Dot(surfNormal)) or Vector3.zero
                if tangent.Magnitude < 0.05 then
                    tangent = flat - surfNormal * flat:Dot(surfNormal)
                end

                local speed = state.surf_speed or 28
                if tangent.Magnitude > 0.05 then
                    tangent = tangent.Unit * speed
                else
                    tangent = Vector3.zero
                end

                local surfVelocity = Vector3.new(tangent.X, 0, tangent.Z)
                hrp.AssemblyLinearVelocity = surfVelocity
                hrp.CFrame = CFrame.new(hrp.Position.X, surfHeight, hrp.Position.Z) * hrp.CFrame.Rotation

                velocity = surfVelocity
                flat = flatOf(surfVelocity)
                movementStats.surfing = true
                movementStats.surf_height = surfHeight
            else
                surfHeight = nil
                surfNormal = nil
            end
        end
    else
        surfHeight = nil
        surfNormal = nil
    end

    if ladder and state.fast_ladder and bindDown("fast_ladder") then
        local up = UserInputService:IsKeyDown(Enum.KeyCode.W)
        local down = UserInputService:IsKeyDown(Enum.KeyCode.S)
        local y = velocity.Y
        if up then
            y = math.max(y, 24)
        elseif down then
            y = math.min(y, -24)
        end
        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X * 1.5, y, velocity.Z * 1.5)
        velocity = hrp.AssemblyLinearVelocity
        flat = flatOf(velocity)
    end

    if state.ladder_edge_jump and bindDown("ladder_edge_jump") and ladder and spaceDown then
        jump()
    end

    if state.fireman and bindDown("fireman") and not grounded and spaceDown and cam
        and now - lastFireman > 0.4 then
        local look = flatOf(cam.CFrame.LookVector)
        if look.Magnitude > 0.1 then
            look = look.Unit
            local wall = workspace:Raycast(hrp.Position, look * 2.6, getWorldFilter())
            if wall then
                local upOrigin = hrp.Position + Vector3.new(0, 6, 0) + look * 0.6
                local ledge = workspace:Raycast(upOrigin, Vector3.new(0, -7, 0), getWorldFilter())
                if ledge and ledge.Normal.Y > 0.7 then
                    local rise = math.clamp((ledge.Position.Y - hrp.Position.Y) * 3 + 26, 30, 60)
                    hrp.AssemblyLinearVelocity = Vector3.new(look.X * 20, rise, look.Z * 20)
                    velocity = hrp.AssemblyLinearVelocity
                    flat = flatOf(velocity)
                    lastFireman = now
                end
            end
        end
    end

    if state.texture_bug and bindDown("texture_bug") and not grounded
        and now - lastTexture > 0.2 and flat.Magnitude > 2 then
        local wall = workspace:Raycast(hrp.Position, flat.Unit * 1.2, getWorldFilter())
        if wall and math.abs(wall.Normal.Y) < 0.3 and velocity.Y < 10 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                velocity.X + wall.Normal.X * 3,
                math.max(velocity.Y, 15),
                velocity.Z + wall.Normal.Z * 3
            )
            velocity = hrp.AssemblyLinearVelocity
            flat = flatOf(velocity)
            lastTexture = now
        end
    end

    if state.mini_jump and bindDown("mini_jump") and grounded and now - lastMiniJump > 0.25 then
        lastMiniJump = now
        hrp.AssemblyLinearVelocity = Vector3.new(
            hrp.AssemblyLinearVelocity.X, 22, hrp.AssemblyLinearVelocity.Z
        )
    end

    if state.null_strafe and not state.auto_strafe and not grounded and not ladder then
        local velocity2 = hrp.AssemblyLinearVelocity
        local flat2 = flatOf(velocity2)
        if flat2.Magnitude > 0.1 and flat2.Magnitude < 60 then
            local wish = moveDirection
            if wish.Magnitude > 0.1 then
                local target = wish.Unit * math.max(flat2.Magnitude, 16)
                local blend = Vector3.new(
                    flat2.X + (target.X - flat2.X) * 0.08,
                    0,
                    flat2.Z + (target.Z - flat2.Z) * 0.08
                )
                hrp.AssemblyLinearVelocity = Vector3.new(blend.X, velocity2.Y, blend.Z)
            end
        end
    end
end)

if state.mousespeed_lim or true then
    local lastCamera = camera() and camera().CFrame or CFrame.new()
    RunService:BindToRenderStep("bankroll_mslim", Enum.RenderPriority.Camera.Value + 2, function()
        local cam = camera()
        if not cam then return end
        if not state.mousespeed_lim then
            lastCamera = cam.CFrame
            return
        end
        local delta = lastCamera.LookVector:Dot(cam.CFrame.LookVector)
        local angle = math.deg(math.acos(math.clamp(delta, -1, 1)))
        local limit = 2.5
        if angle > limit then
            local blended = lastCamera.LookVector:Lerp(cam.CFrame.LookVector, limit / angle)
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + blended)
        end
        lastCamera = cam.CFrame
    end)
end


