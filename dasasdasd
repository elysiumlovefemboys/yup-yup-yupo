if type(getgenv().bankroll_connections) == "table" then
    for _, item in ipairs(getgenv().bankroll_connections) do
        pcall(function() item:Disconnect() end)
    end
end
getgenv().bankroll_connections = {}

local bankrollGeneration = (getgenv().bankroll_generation or 0) + 1
getgenv().bankroll_generation = bankrollGeneration

local function connect(signal, callback)
    local connection
    connection = signal:Connect(function(...)
        if getgenv().bankroll_generation ~= bankrollGeneration then
            pcall(function() connection:Disconnect() end)
            return
        end
        return callback(...)
    end)
    table.insert(getgenv().bankroll_connections, connection)
    return connection
end

