local function hitboxList(char)
    local list = {}
    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant:GetAttribute("Hitbox") then
            table.insert(list, descendant)
        end
    end
    if #list == 0 then
        return { char }
    end
    return list
end

local function ClosestPart(char)
    local cam = camera()
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestDist = nil, math.huge
    for _, part in char:GetDescendants() do
        if not part:IsA("BasePart") then continue end
        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = part
        end
    end
    return best
end

local function ClosestPoint(part, mode, scale)
    local cam = camera()
    if not cam then return part.Position end
    local ray = cam:ScreenPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local cf = part.CFrame
    local sz = part.Size

    if mode == "Raycast" then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = {part}
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        return result and result.Position or part.Position

    elseif mode == "Lyric" then
        local scaleX = type(scale) == "table" and (scale[1] or 0.5) or (scale or 0.5)
        local scaleY = type(scale) == "table" and (scale[2] or scaleX) or scaleX
        local halfX = sz.X * scaleX * 0.5
        local halfY = sz.Y * scaleY * 0.5
        local halfZ = sz.Z * scaleX * 0.5
        local lo = cf:PointToObjectSpace(ray.Origin)
        local ld = cf:VectorToObjectSpace(ray.Direction * 1000)
        local t = math.abs(ld.Z) > 1e-6 and (-lo.Z / ld.Z) or 0
        local lh = lo + ld * t
        return cf:PointToWorldSpace(Vector3.new(
            math.clamp(lh.X, -halfX, halfX),
            math.clamp(lh.Y, -halfY, halfY),
            math.clamp(lh.Z, -halfZ, halfZ)
        ))

    else
        local s = type(scale) == "number" and scale or 0.5
        local half = sz * s * 0.5
        local lo = cf:PointToObjectSpace(ray.Origin)
        local ld = cf:VectorToObjectSpace(ray.Direction * 1000)
        local t = math.abs(ld.Z) > 1e-6 and (-lo.Z / ld.Z) or 0
        local lh = lo + ld * t
        return cf:PointToWorldSpace(Vector3.new(
            math.clamp(lh.X, -half.X, half.X),
            math.clamp(lh.Y, -half.Y, half.Y),
            math.clamp(lh.Z, -half.Z, half.Z)
        ))
    end
end

aimPointOnPart = function(part, char, origin, direction)
    if not part or not part.Parent then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = hitboxList(char)
    params.RespectCanCollide = false

    local trace = workspace:Raycast(origin, direction * 1000, params)
    if trace then return trace.Position end

    local half = part.Size * 0.5
    local localOrigin = part.CFrame:PointToObjectSpace(origin)
    local localDir = part.CFrame:VectorToObjectSpace(direction)

    local near = localOrigin
    if localDir.Magnitude > 1e-6 then
        local dir = localDir.Unit
        near = localOrigin + dir * math.max(-localOrigin:Dot(dir), 0)
    end

    local clamped = Vector3.new(
        math.clamp(near.X, -half.X, half.X),
        math.clamp(near.Y, -half.Y, half.Y),
        math.clamp(near.Z, -half.Z, half.Z)
    )
    return part.CFrame:PointToWorldSpace(clamped)
end

