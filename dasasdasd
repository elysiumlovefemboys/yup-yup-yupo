    function sectionInterface:TextInput(key, placeholder, onEnter)
        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 17),
            BackgroundTransparency = 1
        })

        local textFrame = create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(9, 8, 10),
            BorderSizePixel = 0
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 2) }),
            create("UIStroke", { Color = Colors.CbBorder, Thickness = 1 }),
            create("UIGradient", {
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, Color3.fromRGB(20, 18, 23)),
                    ColorSequenceKeypoint.new(1.0, Color3.fromRGB(9, 8, 10))
                })
            })
        })
        textFrame.Parent = row

        local textBox = create("TextBox", {
            Size = UDim2.new(1, -12, 1, 0),
            Position = UDim2.new(0, 6, 0, 0),
            BackgroundTransparency = 1,
            Text = state[key] or "",
            PlaceholderText = placeholder or "...",
            PlaceholderColor3 = Colors.TextDim,
            TextColor3 = Colors.TextBright,
            Font = Enum.Font.SourceSans,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false
        })
        textBox.Parent = textFrame

        textBox:GetPropertyChangedSignal("Text"):Connect(function()
            state[key] = textBox.Text
            if onEnter then onEnter(textBox.Text) end
        end)

        textBox.Focused:Connect(function()
            textFrame:FindFirstChildOfClass("UIStroke").Color = Colors.Accent()
        end)

        textBox.FocusLost:Connect(function()
            textFrame:FindFirstChildOfClass("UIStroke").Color = Colors.CbBorder
        end)

        local function update()
            if textBox.Text ~= state[key] then
                textBox.Text = state[key] or ""
            end
        end

        table.insert(UI_Updates, update)

        row.Parent = outline
    end

    function sectionInterface:Dummy(height)
        local dum = create("Frame", {
            Size = UDim2.new(1, 0, 0, height),
            BackgroundTransparency = 1
        })
        dum.Parent = outline
    end

    function sectionInterface:Label(text, height)
        local label = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, height or 14),
