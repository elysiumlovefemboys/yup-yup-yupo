applySkinChanger = function(weapon, skin, pattern)
    if not weapon or not skin then return false, "pick a weapon and skin" end
    pattern = tostring(pattern or "1")

    local catalog = skinCatalog()
    local info = catalog and catalog.weapons[weapon]
    if not info then return false, "unknown weapon" end

    if info.category == "Gloves" then
        if skin == "Stock" then
            desiredGloves = { weapon = "Stock", skin = "mirage", pattern = "1" }
            applyGlovesNow()
            return true, "gloves reset"
        end
        applyGloveChange(weapon, skin, pattern)
        return true, "gloves · " .. skin
    end

    if not equipment then return false, "equipment module missing" end
    local okTable, table_ = pcall(equipment.GetEquipmentTable)
    if not okTable or type(table_) ~= "table" or type(table_.Equipment) ~= "table" then
        return false, "equipment table missing"
    end

    local slotKey, slot
    if info.category == "Knives" then
        slotKey = "Melee"
        slot = table_.Equipment[slotKey]
        if slot then slot.Name = weapon end
    else
        for key, entry in pairs(table_.Equipment) do
            if type(entry) == "table" and entry.Name == weapon then
                slotKey, slot = key, entry
                break
            end
        end
    end

    if not slot then
        return false, "equip " .. weapon .. " first"
    end

    slot.Skin = skin
    slot.PatternNumber = tonumber(pattern) or 1
    desiredSkins[weapon] = { skin = skin, pattern = slot.PatternNumber }

    local equippedType = table_.Attributes and table_.Attributes.EquippedType
    if equippedType == slotKey then
        local viewmodel = viewmodelModule()
        if viewmodel then pcall(viewmodel.EquipEquipment, weapon) end
    end

    return true, string.format("%s · %s · p%s", weapon, skin, pattern)
end

