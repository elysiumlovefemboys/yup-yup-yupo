    { texture = "rbxassetid://2382169232", width = 0.3, segments = 1, textureLength = 5,
      textureMode = Enum.TextureMode.Stretch, textureSpeed = 0 },
    { texture = "rbxassetid://7151778302", width = 1.2, segments = 10, textureLength = 1,
      textureMode = Enum.TextureMode.Stretch, textureSpeed = 1 },
    { texture = "rbxassetid://7071778278", width = 0.6, segments = 1, textureLength = 12,
      textureMode = Enum.TextureMode.Wrap, textureSpeed = 1 },
}

local tracerFolder = Instance.new("Folder")
tracerFolder.Name = "bankroll_tracers"
tracerFolder.Parent = workspace.Terrain

local function tracerStyle()
    return TRACER_TEXTURES[math.clamp(state.tracer_texture or 2, 1, #TRACER_TEXTURES)]
end

local function spawnTracer(from, to, color, alpha)
    if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return end
    local delta = to - from
    if delta.Magnitude < 0.1 then return end

    local style = tracerStyle()

    local part = Instance.new("Part")
    part.Name = "bankroll_tracer"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Transparency = 1
    part.Size = Vector3.new(0.2, 0.2, 0.2)
    part.CFrame = CFrame.new(from)

    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.zero
    a0.Parent = part

    local a1 = Instance.new("Attachment")
    a1.Position = delta
    a1.Parent = part

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Color = ColorSequence.new(color)
    beam.Transparency = NumberSequence.new(math.clamp(1 - alpha, 0, 1))
    beam.Width0 = style.width
    beam.Width1 = style.width
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Segments = style.segments
    beam.Texture = style.texture
    beam.TextureLength = style.textureLength
    beam.TextureMode = style.textureMode
    beam.TextureSpeed = style.textureSpeed
    beam.Parent = part

    part.Parent = tracerFolder

    task.delay(math.max(state.tracer_time or 4, 0.1), function()
        if part and part.Parent then part:Destroy() end
    end)
end

local function spawnImpact(position, normal)
    if typeof(position) ~= "Vector3" then return end
    local part = Instance.new("Part")
    part.Name = "bankroll_impact"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(0.35, 0.35, 0.35)
    part.Color = state.tracer_impact_color
    part.Transparency = 1 - state.tracer_impact_alpha
    part.CFrame = CFrame.new(position + (normal or Vector3.yAxis) * 0.04)
    part.Parent = tracerFolder

    task.delay(0.5, function()
        if part.Parent then part:Destroy() end
    end)
end

local function visualOnShot(payload, final)
    if type(payload) ~= "table" or not final then return end

    if state.tracer_local then
        local drawn = false
        if type(payload[3]) == "table" then
            for _, pair in ipairs(payload[3]) do
                if type(pair) == "table" and pair[1] and pair[2] then
                    spawnTracer(pair[1], pair[2], state.tracer_local_color, state.tracer_local_alpha)
                    drawn = true
