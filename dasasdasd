local worldLightingAt = 0

local function updateWorld()
    local cam = camera()
    if not cam then return end

    local index = 0
    local function draw(inst, color, alpha, text, maxDistance, showDistance)
        local position = objectPosition(inst)
        if not position then return end

        local screen, onScreen = cam:WorldToViewportPoint(position)
        if not onScreen then return end

        local distance = (cam.CFrame.Position - position).Magnitude
        if maxDistance and distance > maxDistance then return end

        index = index + 1
        local label = worldLabel(index)
        label.Text = showDistance and string.format("%s · %dm", text, math.floor(distance)) or text
        label.TextColor3 = color
        label.TextTransparency = 1 - alpha
        label.TextSize = math.clamp(state.world_label_size or 11, 8, 20)
        label.BackgroundTransparency = state.world_label_bg and 0.55 or 1
        label.Position = UDim2.fromOffset(screen.X, screen.Y)
        label.Visible = true
    end

    if state.world_drops then
        local folder = propsFolder("Dropped")
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                local name = findAttributeDeep(item, "WeaponName", "DisplayName", "Name") or item.Name
                local text = tostring(name)
                if state.world_drops_skin then
                    local skin = findAttributeDeep(item, "SkinName", "Skin")
                    if skin and skin ~= "" and skin ~= "Stock" then
                        text = text .. " · " .. tostring(skin)
                    end
                end
                draw(item, state.world_drops_color, state.world_drops_alpha, text,
                    state.world_drops_max, state.world_drops_distance)
            end
        end
    end

    local grenades = propsFolder("Grenades")
    if grenades then
        for _, item in ipairs(grenades:GetChildren()) do
            if state.world_grenades then
                local name = item.Name ~= "" and item.Name or "grenade"
                draw(item, state.world_grenades_color, state.world_grenades_alpha,
                    name, nil, state.world_grenades_distance)
            end
            pcall(ensureGrenadeTrail, item)
        end
    end

    if state.world_bomb then
        local folder = propsFolder("Bomb")
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                local text = "bomb"
                if state.world_bomb_timer then
                    local timeLeft = findAttributeDeep(item, "TimeLeft", "Timer", "Time", "Countdown", "Seconds")
                    if type(timeLeft) == "number" then
                        text = string.format("%s · %.1fs", text, timeLeft)
                    end
                end
                draw(item, state.world_bomb_color, state.world_bomb_alpha, text,
                    nil, state.world_bomb_distance)
            end
        end
    end

    for i = index + 1, #worldLabels do
        worldLabels[i].Visible = false
    end

    local trajIndex = 0
    local maxSegments = math.clamp(math.floor(state.grenade_traj_segments or 36), 4, 60)

    local function drawArc(points, thickScale)
        local count = #points
        if count < 2 then return end
        local alpha = state.grenade_traj_alpha or 0.9
        local step = (count - 1) / maxSegments
        for k = 0, maxSegments - 1 do
            if trajIndex >= maxSegments then break end
            local indexA = math.floor(k * step) + 1
            local indexB = math.min(math.floor((k + 1) * step) + 1, count)
            local a, b = points[indexA], points[indexB]
            local segment = b - a
            if segment.Magnitude > 0.02 then
                trajIndex = trajIndex + 1
                local line = trajLine(trajIndex)
                local t = (trajIndex - 1) / math.max(maxSegments - 1, 1)
                local size = math.max((state.grenade_traj_thickness or 2) * (thickScale or 1) * 0.045, 0.03)
                line.CFrame = CFrame.lookAt((a + b) * 0.5, b)
                line.Size = Vector3.new(size, size, segment.Magnitude + size)
                line.Color = state.grenade_traj_color:Lerp(state.grenade_traj_color2, t)
                line.Transparency = 1 - alpha
            end
        end
    end

    if state.grenade_traj then
        if state.world_grenades and grenades then
            for _, item in ipairs(grenades:GetChildren()) do
                local origin, velocity = grenadeProfile(item)
                if origin and velocity and velocity.Magnitude > 2 then
                    drawArc(simulateArc(origin, velocity, 220, 0.03), 1)
                end
            end
        end

        if state.grenade_traj_held then
            local held = equipped()
            local heldName = held and held.Name and string.lower(tostring(held.Name)) or ""
            if heldName ~= "" and (string.find(heldName, "grenade")
                or string.find(heldName, "flash") or string.find(heldName, "smoke")
                or string.find(heldName, "decoy") or string.find(heldName, "incendiary")
                or string.find(heldName, "molotov") or string.find(heldName, "he")) then
                local origin = cam.CFrame.Position + cam.CFrame.LookVector * 1.2
                local power = state.grenade_traj_power or 62
                local lift = state.grenade_traj_lift or 0.34
                local velocity = cam.CFrame.LookVector * power + Vector3.new(0, power * lift, 0)
                drawArc(simulateArc(origin, velocity, 220, 0.03), 1.4)
            end
        end
    end

    for i = trajIndex + 1, #trajLines do
        trajLines[i].Transparency = 1
    end

    pcall(updateLocalChams)
    if state.local_chams then pcall(_claritySelfChams) end
    pcall(maintainSkins)

    local now = os.clock()
    if now - worldLightingAt >= 0.25 then
        worldLightingAt = now
        applyWorldLighting()
    end
end

