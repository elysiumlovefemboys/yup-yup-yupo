local statsService = game:GetService("Stats")

local function pingValue()
    local network = statsService:FindFirstChild("Network")
    local server = network and network:FindFirstChild("ServerStatsItem")
    local ping = server and server:FindFirstChild("Data Ping")
    return ping and math.floor(ping:GetValue() + 0.5) or 0
end

local fpsFrames, fpsTime, fpsValue = 0, 0, 0
local savedFov = nil

local function updateHud(dt)
    local cam = camera()
    local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)

    if cam then
        if state.extra_custom_fov then
            if not savedFov then savedFov = cam.FieldOfView end
            cam.FieldOfView = state.extra_fov
        elseif savedFov then
            cam.FieldOfView = savedFov
            savedFov = nil
        end
    end

    watermarkLabel.Visible = state.extra_watermark
    if state.extra_watermark then
        watermarkLabel.TextColor3 = state.extra_watermark_color
        watermarkLabel.TextTransparency = 1 - state.extra_watermark_alpha
    end

    fpsFrames = fpsFrames + 1
    fpsTime = fpsTime + dt
    if fpsTime >= 0.5 then
        fpsValue = math.floor(fpsFrames / fpsTime + 0.5)
        fpsFrames, fpsTime = 0, 0
    end

    local lines = {}
    if state.extra_fps then table.insert(lines, string.format("fps %d", fpsValue)) end
    if state.extra_ping then table.insert(lines, string.format("ping %dms", pingValue())) end
    if state.extra_players then table.insert(lines, string.format("players %d", #Players:GetPlayers())) end
    if state.extra_clock then table.insert(lines, os.date("%H:%M:%S")) end

    statsLabel.Visible = #lines > 0
    if #lines > 0 then
        statsLabel.Position = UDim2.fromOffset(viewport.X - 230, 6)
        statsLabel.TextColor3 = state.extra_stats_color
        statsLabel.TextTransparency = 1 - state.extra_stats_alpha
        statsLabel.Text = table.concat(lines, "\n")
    end

    crosshairFrame.Visible = state.extra_crosshair
    if state.extra_crosshair then
        local colour = state.extra_crosshair_color
        local transparency = 1 - state.extra_crosshair_alpha
        local length, gap, thickness = 6, 4, 1

        local specs = {
            { viewport.X * 0.5 - gap - length * 0.5, viewport.Y * 0.5, length, thickness },
            { viewport.X * 0.5 + gap + length * 0.5, viewport.Y * 0.5, length, thickness },
            { viewport.X * 0.5, viewport.Y * 0.5 - gap - length * 0.5, thickness, length },
            { viewport.X * 0.5, viewport.Y * 0.5 + gap + length * 0.5, thickness, length },
        }

        for index, spec in ipairs(specs) do
            local bar = crossBars[index]
            bar.Position = UDim2.fromOffset(spec[1], spec[2])
            bar.Size = UDim2.fromOffset(spec[3], spec[4])
            bar.BackgroundColor3 = colour
            bar.BackgroundTransparency = transparency
        end

        crossDot.Position = UDim2.fromOffset(viewport.X * 0.5, viewport.Y * 0.5)
        crossDot.BackgroundColor3 = colour
        crossDot.BackgroundTransparency = transparency
    end

    if cam then
        local camFov = math.max(cam.FieldOfView, 1)
        local screenHalf = viewport.Y * 0.5
        local function ringRadius(degrees)
            local half = math.rad(math.clamp(degrees or 0, 0.1, 179) * 0.5)
            return math.tan(half) / math.tan(math.rad(camFov) * 0.5) * screenHalf
        end

        local colour = state.fov_vis_color
        local transparency = 1 - state.fov_vis_alpha

        fovRing.Visible = state.show_fov
        if state.show_fov then
            local radius = ringRadius(state.fov)
            fovRing.Size = UDim2.fromOffset(radius * 2, radius * 2)
            fovRingStroke.Color = colour
            fovRingStroke.Transparency = transparency
        end

        silentFovRing.Visible = state.show_silent_fov
        if state.show_silent_fov then
            local radius = ringRadius(state.silent_fov)
            silentFovRing.Size = UDim2.fromOffset(radius * 2, radius * 2)
            silentFovRingStroke.Color = colour
            silentFovRingStroke.Transparency = transparency
        end
    else
        fovRing.Visible = false
        silentFovRing.Visible = false
    end
end

connect(RunService.RenderStepped, function(dt)
    pcall(updateHud, dt)
end)


local soundFolder = Instance.new("Folder")
soundFolder.Name = "bankroll_sounds"
soundFolder.Parent = game:GetService("SoundService")

local HIT_SOUND = "rbxassetid://5680197204"

local function playSound()
    if not state.sounds then return end
    local sound = Instance.new("Sound")
    sound.SoundId = HIT_SOUND
    sound.Volume = math.clamp(state.sounds_volume / 100, 0, 1)
    sound.Parent = soundFolder
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    task.delay(3, function() if sound.Parent then sound:Destroy() end end)
end


local keyAccent = Color3.fromRGB(175, 100, 200)
local keyIdle = Color3.fromRGB(120, 120, 130)

connect(RunService.RenderStepped, function()
    keyFrame.Visible = state.keystrokes
    if state.keystrokes then
        for name, label in pairs(keyLabels) do
            local down = keyIsDown(name)
            label.BackgroundColor3 = down and keyAccent or Color3.fromRGB(15, 15, 18)
            label.TextColor3 = down and Color3.new(1, 1, 1) or keyIdle
        end
        local spaceDown = keyIsDown("SPACE")
        spaceBar.BackgroundColor3 = spaceDown and keyAccent or Color3.fromRGB(15, 15, 18)
        spaceBar.TextColor3 = spaceDown and Color3.new(1, 1, 1) or keyIdle
    end

    local hrp = root()
    local speed = 0
    if hrp then
        local flat = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
        speed = flat.Magnitude
    end

    velocityLabel.Visible = state.vel_text
    if state.vel_text then
        local colour = state.vel_text_col1
        if speed > 40 then colour = state.vel_text_col3
        elseif speed > 20 then colour = state.vel_text_col2 end
        velocityLabel.TextColor3 = colour
        velocityLabel.Text = string.format("%.1f u/s", speed)
        velocityLabel.TextTransparency = 1 - state.vel_text_alpha1
    end

    graphFrame.Visible = state.vel_graph
    if state.vel_graph then
        table.remove(velocitySamples, 1)
        table.insert(velocitySamples, speed)

        local peak = 40
        for _, sample in ipairs(velocitySamples) do
            peak = math.max(peak, sample)
        end
        for index, bar in ipairs(graphBars) do
            local fraction = math.clamp(velocitySamples[index] / peak, 0, 1)
            bar.Size = UDim2.new(1 / GRAPH_SAMPLES, -1, 0, math.max(fraction * 40, 1))
            bar.BackgroundColor3 = velocitySamples[index] >= peak * 0.66
                and state.vel_graph_col1 or state.vel_graph_col2
            bar.BackgroundTransparency = 1 - state.vel_graph_alpha1
        end
    end

    indicatorLabel.Visible = state.ind_keybinds
    if state.ind_keybinds then
        local lines = {}
        for name, bind in pairs(binds) do
            if state[name] == true and (bind ~= "none" or bindMode(name) == "always on") then
                table.insert(lines, string.format("%s [%s]", name, bindLabel(name)))
            end
        end
        table.sort(lines)
        indicatorLabel.Position = UDim2.new(0, 20, 0, state.ind_offset)
        indicatorLabel.TextColor3 = state.keybinds_col2
        indicatorLabel.TextTransparency = 1 - state.keybinds_alpha1
        indicatorLabel.Text = table.concat(lines, "\n")
    end

    local hum = humanoid()
    if hum then
        if lastHealth and hum.Health < lastHealth and state.healthshot then
            healthshotAlpha = 0
        end
        lastHealth = hum.Health
    end
    if healthshotAlpha < 1 then
        healthshotAlpha = math.min(healthshotAlpha + 0.06, 1)
    end
    healthshotFrame.BackgroundTransparency = healthshotAlpha
end)

