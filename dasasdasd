local function _reverseChamsPlr(plr)
    if not plr.Character then return end
    local char = plr.Character
    local stored = _chamsAdornments[char]
    if stored then
        for _, a in stored.inner do pcall(function() a:Destroy() end) end
        for _, a in stored.outer do pcall(function() a:Destroy() end) end
        _chamsAdornments[char] = nil
    end
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") then
            local origMat = part:GetAttribute("OrigMat")
            if origMat then
                pcall(function()
                    part.Material = Enum.Material[origMat]
                    local origColor = part:GetAttribute("OrigColor")
                    if origColor then part.Color = origColor end
                end)
                part:SetAttribute("OrigMat", nil)
                part:SetAttribute("OrigColor", nil)
            end
        end
    end
end

