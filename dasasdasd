local worldFilter, worldFilterAt = nil, 0

local function getWorldFilter()
    local now = os.clock()
    if worldFilter and now - worldFilterAt < 1 then
        return worldFilter
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local ignore = { camera() }
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignore, plr.Character) end
    end

    local map = workspace:FindFirstChild("WorldView") and workspace.WorldView:FindFirstChild("Map")
    if map then
        local clips = map:FindFirstChild("Clips")
        if clips then table.insert(ignore, clips) end
        local parts = map:FindFirstChild("Parts")
        local collisions = parts and parts:FindFirstChild("PartCollisions")
        if collisions then table.insert(ignore, collisions) end
    end

    params.FilterDescendantsInstances = ignore
    worldFilter, worldFilterAt = params, now
    return params
end

local function visible(origin, position)
    return workspace:Raycast(origin, position - origin, getWorldFilter()) == nil
end


local history = {}
local HISTORY_SECONDS = 0.2

local function recordHistory()
    local now = os.clock()
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            local list = history[plr]
            if not list then
                list = {}
                history[plr] = list
            end
            table.insert(list, { t = now, p = head.Position })
            while list[1] and now - list[1].t > HISTORY_SECONDS do
                table.remove(list, 1)
            end
        else
            history[plr] = nil
        end
    end
end

local function backtrackPosition(plr, fallback)
    if not state.backtrack then return fallback end
    local list = history[plr]
    if not list or #list == 0 then return fallback end
    local target = os.clock() - (state.delay > 0 and state.delay or 0.1)
    local best = list[1]
    for _, entry in ipairs(list) do
        if math.abs(entry.t - target) < math.abs(best.t - target) then
            best = entry
        end
    end
    return best.p
end


